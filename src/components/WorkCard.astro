---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const d = project.data;

const Tag = d.url ? 'a' : 'article';
const linkProps = d.url ? { href: d.url, rel: 'noopener noreferrer' } : {};
---

<Tag class:list={['slide', `slide--${d.variant}`]} {...linkProps}>
  {
    d.variant === 'feature' ? (
      <>
        <span class="blob" aria-hidden="true" />
        <p class="meta">
          <span>{d.kicker}</span>
          <span>{d.badge}</span>
        </p>
        <div class="body">
          <h2 class="title title--big">{d.title}</h2>
          {d.summary && <p class="summary">{d.summary}</p>}
        </div>
      </>
    ) : d.variant === 'compact' ? (
      <>
        {d.cover ? (
          <Image class="cover" src={d.cover} alt={d.coverAlt} widths={[400, 800]} />
        ) : (
          <>
            <span class="hatch hatch--neg" aria-hidden="true" />
            <span class="slot-label">{d.coverLabel}</span>
          </>
        )}
        <h2 class="title title--overlay">{d.title}</h2>
        <p class="year">{d.year}</p>
      </>
    ) : (
      <>
        <div class="frame">
          {d.cover ? (
            <Image class="cover" src={d.cover} alt={d.coverAlt} widths={[500, 1000]} />
          ) : (
            <>
              <span class="hatch hatch--45" aria-hidden="true" />
              <span class="slot-label">{d.coverLabel}</span>
            </>
          )}
        </div>
        <div class="foot">
          <div class="foot__text">
            <h2 class="title">{d.title}</h2>
            <p class="stack">{d.stack ?? d.year}</p>
          </div>
          <span class="arrow" aria-hidden="true">↗</span>
        </div>
      </>
    )
  }
</Tag>

<style>
  /* Semua slide berukuran sama supaya deretannya rapi saat digeser.
     Varian hanya mengubah warna dan susunan isinya. */
  .slide {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-md);
    display: block;
    color: inherit;
    width: 100%;
    height: 100%;
    transition:
      transform .28s cubic-bezier(.2,.8,.2,1),
      box-shadow .28s cubic-bezier(.2,.8,.2,1);
  }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    /* Judul boleh multi-baris dari YAML tanpa perlu HTML mentah. */
    white-space: pre-line;
  }

  /* ---- showcase ---- */
  .slide--showcase {
    background: var(--cream);
    border: var(--line);
    box-shadow: 8px 8px 0 var(--accent3);
    display: grid;
    grid-template-rows: 1fr auto;
  }
  .slide--showcase:hover {
    transform: translate(-5px,-5px) rotate(-.5deg);
    box-shadow: 16px 16px 0 var(--accent3);
  }

  .frame {
    position: relative;
    background: var(--paper);
    border-bottom: var(--line);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 18px;
  }
  .foot__text { min-width: 0; }
  .slide--showcase .title { font-size: 26px; color: var(--ink); line-height: 1; }
  .stack {
    margin: 6px 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
    opacity: .6;
    color: var(--ink);
  }
  .arrow {
    width: 44px; height: 44px;
    flex: none;
    border-radius: 50%;
    border: var(--line);
    display: grid;
    place-items: center;
    background: var(--accent);
    font-size: 18px;
    color: var(--ink);
  }

  /* ---- feature ---- */
  .slide--feature {
    background: var(--ink);
    border: 2px solid var(--cream);
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
  }
  .slide--feature:hover {
    transform: translate(-5px,-5px) rotate(.5deg);
    box-shadow: 16px 16px 0 var(--accent);
  }
  .blob {
    position: absolute;
    left: -60px; bottom: -90px;
    width: 170px; height: 170px;
    border-radius: 50%;
    background: var(--accent);
    opacity: .32;
    animation: floaty 7s ease-in-out infinite;
  }
  .meta {
    position: relative;
    margin: 0;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--cream);
    opacity: .7;
  }
  .body { position: relative; }
  .title--big { font-size: 38px; line-height: .9; color: var(--cream); }
  .summary {
    margin: 12px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--cream);
    opacity: .72;
  }

  /* ---- compact ---- */
  .slide--compact {
    background: var(--paper);
    border: var(--line);
    display: grid;
    place-items: center;
  }
  .slide--compact:hover {
    transform: translate(-5px,-5px);
    box-shadow: 14px 14px 0 var(--accent2);
  }
  .title--overlay {
    position: absolute;
    left: 14px; top: 14px;
    right: 14px;
    font-size: 20px;
    color: var(--ink);
  }
  .year {
    position: absolute;
    left: 14px; bottom: 14px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .1em;
    color: var(--ink);
    opacity: .6;
  }

  .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 680px) {
    .title--big { font-size: 32px; }
  }
</style>
