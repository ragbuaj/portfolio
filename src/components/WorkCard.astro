---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Nomor urut di carousel, dipakai sebagai angka besar dekoratif. */
  index: number;
}

const { project, index } = Astro.props;
const d = project.data;

// Susunan kartu ditentukan ada-tidaknya gambar, bukan oleh field terpisah.
// Tanpa gambar, kartu jadi kartu teks — bukan kotak berarsir yang kosong.
const punyaGambar = Boolean(d.cover);

// Link keluar dibuka di tab baru supaya pengunjung tidak meninggalkan situs.
const Tag = d.url ? 'a' : 'article';
const linkProps = d.url
  ? { href: d.url, target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<Tag
  class:list={['slide', punyaGambar ? 'slide--gambar' : 'slide--teks', `tone-${d.tone}`]}
  {...linkProps}
>
  {
    punyaGambar ? (
      <>
        {d.badge && <span class="tag">{d.badge}</span>}
        <div class="frame">
          <Image class="cover" src={d.cover!} alt={d.coverAlt} widths={[500, 1000]} />
        </div>
        <div class="foot">
          <div class="foot__text">
            <h2 class="title">{d.title}</h2>
            <p class="stack">{d.stack ?? d.year}</p>
          </div>
          {d.url && <span class="arrow" aria-hidden="true">↗</span>}
        </div>
      </>
    ) : (
      <>
        <span class="kisi" aria-hidden="true" />
        <span class="blob" aria-hidden="true" />
        <span class="angka" aria-hidden="true">{String(index).padStart(2, '0')}</span>
        <p class="meta">
          <span>{d.year}</span>
          <span>{d.badge}</span>
        </p>
        <div class="body">
          <h2 class="title title--big">{d.title}</h2>
          {d.summary && <p class="summary">{d.summary}</p>}
          {d.stack && <p class="stack stack--teks">{d.stack}</p>}
        </div>
      </>
    )
  }
</Tag>

<style>
  .slide {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-md);
    display: block;
    color: inherit;
    width: 100%;
    height: 100%;
    transition:
      transform .28s cubic-bezier(.2,.8,.2,1),
      box-shadow .28s cubic-bezier(.2,.8,.2,1);
  }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    /* Judul boleh multi-baris dari YAML tanpa perlu HTML mentah. */
    white-space: pre-line;
  }

  /* ---------- Warna ----------

     Teks selalu mengikuti latar: latar gelap dapat teks krem, latar berwarna
     dapat teks tinta. Kebalikannya hanya menghasilkan rasio 2,2-2,5:1, jauh
     di bawah ambang keterbacaan. Yang dipakai di sini 6,7:1 sampai 16,9:1. */
  .tone-ink {
    --kartu-bg: var(--ink);
    --kartu-fg: var(--cream);
    --kartu-tepi: var(--cream);
    --kartu-bayang: var(--accent);
  }
  .tone-accent {
    --kartu-bg: var(--accent);
    --kartu-fg: var(--ink);
    --kartu-tepi: var(--ink);
    --kartu-bayang: var(--ink);
  }
  .tone-accent2 {
    --kartu-bg: var(--accent2);
    --kartu-fg: var(--ink);
    --kartu-tepi: var(--ink);
    --kartu-bayang: var(--ink);
  }
  .tone-accent3 {
    --kartu-bg: var(--accent3);
    --kartu-fg: var(--ink);
    --kartu-tepi: var(--ink);
    --kartu-bayang: var(--ink);
  }

  /* ---------- Kartu teks (tanpa gambar) ---------- */
  .slide--teks {
    background: var(--kartu-bg);
    border: 2px solid var(--kartu-tepi);
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
  }
  .slide--teks:hover {
    transform: translate(-5px,-5px) rotate(.5deg);
    box-shadow: 16px 16px 0 var(--kartu-bayang);
  }

  /* ---------- Dekorasi kartu teks ----------

     Semuanya memakai warna teks kartu itu sendiri pada opacity rendah, jadi
     ikut menyesuaikan tiap warna latar tanpa perlu diatur satu per satu.
     Isi kartu diangkat ke z-index 1 supaya selalu berada di atasnya. */

  /* Kisi halus melintasi seluruh kartu, mengutip latar kartu hero. Sengaja
     ditahan di .05: ini satu-satunya dekorasi yang lewat di belakang teks. */
  .kisi {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      repeating-linear-gradient(0deg, var(--kartu-fg) 0 1px, transparent 1px 26px),
      repeating-linear-gradient(90deg, var(--kartu-fg) 0 1px, transparent 1px 26px);
    opacity: .05;
  }

  /* Angka besar bergaris luar, mengutip perlakuan kata "KIRIM" di hero.
     Boleh tebal karena berada di luar kolom teks. */
  .angka {
    position: absolute;
    right: -10px;
    bottom: -40px;
    font-family: var(--font-display);
    font-size: 150px;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px var(--kartu-fg);
    opacity: .34;
    pointer-events: none;
    user-select: none;
  }

  /* Blob dipindah ke sisi kanan, menyatu dengan angka. Di sisi kiri ia jatuh
     tepat di belakang ringkasan dan menurunkan kontrasnya ke 4,42:1. */
  .blob {
    position: absolute;
    right: -55px; top: 40px;
    width: 170px; height: 170px;
    border-radius: 50%;
    background: var(--kartu-fg);
    opacity: .16;
    animation: floaty 7s ease-in-out infinite;
  }

  .meta {
    position: relative;
    z-index: 1;
    margin: 0;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--kartu-fg);
    /* Teks kecil di atas latar berwarna paling tipis marginnya. Pada .9,
       yang terburuk (koral, di atas kisi) masih 5,53:1. */
    opacity: .9;
  }

  .body {
    position: relative;
    z-index: 1;
    /* Menjaga teks tetap di kiri, terpisah dari angka dan blob di kanan. */
    max-width: 68%;
  }
  .title--big { font-size: 38px; line-height: .9; color: var(--kartu-fg); }

  .summary {
    margin: 12px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--kartu-fg);
    opacity: .9;
  }
  .stack--teks {
    margin: 12px 0 0;
    color: var(--kartu-fg);
    opacity: .9;
  }

  /* ---------- Kartu bergambar ---------- */
  .slide--gambar {
    background: var(--cream);
    border: var(--line);
    box-shadow: 8px 8px 0 var(--accent3);
    display: grid;
    grid-template-rows: 1fr auto;
  }
  .slide--gambar:hover {
    transform: translate(-5px,-5px) rotate(-.5deg);
    box-shadow: 16px 16px 0 var(--accent3);
  }

  .frame {
    position: relative;
    background: var(--paper);
    border-bottom: var(--line);
    overflow: hidden;
  }

  .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 18px;
  }
  .foot__text { min-width: 0; }
  .slide--gambar .title { font-size: 26px; color: var(--ink); line-height: 1; }

  .arrow {
    width: 44px; height: 44px;
    flex: none;
    border-radius: 50%;
    border: var(--line);
    display: grid;
    place-items: center;
    background: var(--accent);
    font-size: 18px;
    color: var(--ink);
  }

  .stack {
    margin: 6px 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
    opacity: .6;
    color: var(--ink);
  }

  /* Penanda di kartu bergambar. Kartu teks memakainya di baris .meta. */
  .tag {
    position: absolute;
    top: 12px; right: 12px;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--cream);
    border: var(--line);
    border-radius: 999px;
    padding: 4px 10px;
  }

  @media (max-width: 680px) {
    .title--big { font-size: 32px; }

    /* Kartu jauh lebih sempit di sini, jadi dekorasi harus mundur lebih jauh
       ke luar tepi — kalau tidak, ia masuk ke belakang teks dan menurunkan
       kontrasnya sampai di bawah ambang. */
    .angka { font-size: 104px; right: -24px; bottom: -30px; }
    .blob { right: -100px; top: 30px; width: 150px; height: 150px; }
    .body { max-width: 76%; }
  }
</style>
