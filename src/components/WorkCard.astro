---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Diteruskan ke id anchor section karya untuk kartu pertama. */
  anchor?: boolean;
}

const { project, anchor = false } = Astro.props;
const d = project.data;

// Pada grid 6 kolom, kartu karya jadi setengah baris. Hanya kartu yang
// memang selebar hero (>=8 dari 12) yang tetap penuh — kalau tidak, akan
// tersisa lubang 3 kolom di sebelahnya.
const spanMd = d.span >= 8 ? 6 : 3;
const styleVars = `--span:${d.span};--span-md:${spanMd}`;

const Tag = d.url ? 'a' : 'article';
const linkProps = d.url ? { href: d.url, rel: 'noopener noreferrer' } : {};
---

<Tag
  id={anchor ? 'karya' : undefined}
  class:list={['cell', 'work', `work--${d.variant}`, 'card--lift']}
  style={styleVars}
  {...linkProps}
>
  {
    d.variant === 'feature' ? (
      <>
        <span class="blob" aria-hidden="true" />
        <p class="meta">
          <span>{d.kicker}</span>
          <span>{d.badge}</span>
        </p>
        <div class="body">
          <h2 class="title title--big">{d.title}</h2>
          {d.summary && <p class="summary">{d.summary}</p>}
        </div>
      </>
    ) : d.variant === 'compact' ? (
      <>
        {d.cover ? (
          <Image class="cover" src={d.cover} alt={d.coverAlt} widths={[400, 800]} />
        ) : (
          <>
            <span class="hatch hatch--neg" aria-hidden="true" />
            <span class="slot-label">{d.coverLabel}</span>
          </>
        )}
        <h2 class="title title--overlay">{d.title}</h2>
      </>
    ) : (
      <>
        <div class="frame">
          {d.cover ? (
            <Image class="cover" src={d.cover} alt={d.coverAlt} widths={[500, 1000]} />
          ) : (
            <>
              <span class="hatch hatch--45" aria-hidden="true" />
              <span class="slot-label">{d.coverLabel}</span>
            </>
          )}
        </div>
        <div class="foot">
          <div>
            <h2 class="title">{d.title}</h2>
            {d.stack && <p class="stack">{d.stack}</p>}
          </div>
          <span class="arrow" aria-hidden="true">↗</span>
        </div>
      </>
    )
  }
</Tag>

<style>
  .work {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-md);
    display: block;
    color: inherit;
  }

  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    /* Judul boleh multi-baris dari YAML tanpa perlu HTML mentah. */
    white-space: pre-line;
  }

  /* ---- showcase ---- */
  .work--showcase {
    background: var(--cream);
    border: var(--line);
    box-shadow: 8px 8px 0 var(--accent3);
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 300px;
  }
  .work--showcase:hover {
    transform: translate(-5px,-5px) rotate(-.5deg);
    box-shadow: 16px 16px 0 var(--accent3);
  }

  .frame {
    position: relative;
    background: var(--paper);
    border-bottom: var(--line);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 18px;
  }
  .work--showcase .title { font-size: 28px; color: var(--ink); line-height: 1; }
  .stack {
    margin: 6px 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
    opacity: .6;
    color: var(--ink);
  }
  .arrow {
    width: 44px; height: 44px;
    flex: none;
    border-radius: 50%;
    border: var(--line);
    display: grid;
    place-items: center;
    background: var(--accent);
    font-size: 18px;
    color: var(--ink);
  }

  /* ---- feature ---- */
  .work--feature {
    background: var(--ink);
    border: 2px solid var(--cream);
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    min-height: 300px;
  }
  .work--feature:hover {
    transform: translate(-5px,-5px) rotate(.5deg);
    box-shadow: 16px 16px 0 var(--accent);
  }
  .blob {
    position: absolute;
    left: -60px; bottom: -90px;
    width: 170px; height: 170px;
    border-radius: 50%;
    background: var(--accent);
    opacity: .32;
    animation: floaty 7s ease-in-out infinite;
  }
  .meta {
    position: relative;
    margin: 0;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--cream);
    opacity: .7;
  }
  .body { position: relative; }
  .title--big { font-size: 46px; line-height: .9; color: var(--cream); }
  .summary {
    margin: 12px 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--cream);
    opacity: .72;
    max-width: 26ch;
  }

  /* ---- compact ---- */
  .work--compact {
    background: var(--paper);
    border: var(--line);
    min-height: 230px;
    display: grid;
    place-items: center;
  }
  .work--compact:hover {
    transform: translate(-5px,-5px);
    box-shadow: 14px 14px 0 var(--accent2);
  }
  .title--overlay {
    position: absolute;
    left: 14px; top: 14px;
    font-size: 20px;
    color: var(--ink);
  }

  .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 680px) {
    .work--showcase, .work--feature { min-height: 240px; }
    .title--big { font-size: 36px; }
  }
</style>
