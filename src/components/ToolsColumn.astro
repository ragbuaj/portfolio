---
interface Props {
  title: string;
  items: string[];
}
const { title, items } = Astro.props;
---

<section class="cell tools" style="--span:3;--span-md:3">
  <h2 class="head eyebrow">{title}</h2>
  <div class="viewport marquee">
    <div class="marquee__track">
      {
        [0, 1].map((copy) => (
          <ul class="run" aria-hidden={copy === 1 ? 'true' : undefined}>
            {items.map((item, i) => (
              <li class:list={['item', i % 2 === 1 && 'item--dim']}>{item}</li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tools {
    position: relative;
    overflow: hidden;
    background: var(--cream);
    border: var(--line);
    border-radius: var(--r-md);
    height: 300px;
  }

  .head {
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 2;
    margin: 0;
    padding: 14px 16px 12px;
    background: var(--cream);
    border-bottom: var(--line);
    color: var(--ink);
    font-weight: 400;
  }

  .viewport { height: 100%; padding-top: 44px; }

  /* Vertikal, jadi arah track-nya kolom. */
  .marquee__track {
    display: flex;
    flex-direction: column;
    width: auto;
    animation: marqueeUp 16s linear infinite;
  }

  .run {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 14px 14px 0;
  }

  .item {
    font-family: var(--font-display);
    font-size: 24px;
    text-transform: uppercase;
    color: var(--ink);
  }
  .item--dim { opacity: .55; }

  @media (prefers-reduced-motion: reduce) {
    /* Kolom vertikal tidak enak di-scroll horizontal; biarkan vertikal. */
    .viewport { overflow-y: auto; }
  }
</style>
