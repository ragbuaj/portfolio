---
import { site } from '../lib/site';
const { stat } = site;
---

<section id="tentang" class="cell stat card--lift" style="--span:3;--span-md:2">
  <h2 class="eyebrow label">{stat.label}</h2>
  <p class="value">{stat.value}<span class="unit"> {stat.unit}</span></p>
  <p class="desc">{stat.description}</p>
</section>

<style>
  .stat {
    background: var(--accent3);
    border: var(--line);
    border-radius: var(--r-md);
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    box-shadow: 8px 8px 0 var(--ink);
  }
  .stat:hover {
    transform: translate(-4px,-4px) rotate(-1deg);
    box-shadow: 14px 14px 0 var(--ink);
  }

  .label { margin: 0; color: var(--ink); opacity: .75; font-weight: 400; }

  .value {
    margin: 0;
    font-family: var(--font-display);
    font-size: 74px;
    line-height: .82;
    color: var(--ink);
  }
  .unit { font-size: 26px; }

  .desc { margin: 0; font-size: 14px; line-height: 1.45; color: var(--ink); }
</style>
