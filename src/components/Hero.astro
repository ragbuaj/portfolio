---
import { site } from '../lib/site';

interface Props {
  projectCount: number;
}
const { projectCount } = Astro.props;
const { hero } = site;

// Stagger animasi masuk mengikuti file desain (0.15s, 0.42s, 0.68s).
const delayFor = (i: number) => `${(0.15 + i * 0.265).toFixed(2)}s`;
---

<section class="cell hero" style="--span:8;--span-md:4">
  <div class="grid-lines" aria-hidden="true"></div>
  <div class="blob" aria-hidden="true"></div>

  <p class="eyebrow">
    <span>{hero.eyebrowLeft}</span>
    <span class="rule" aria-hidden="true"></span>
    <span>{hero.eyebrowRight}</span>
  </p>

  <h1 class="headline" aria-label={hero.headline.map((l) => l.text).join(' ')}>
    {
      hero.headline.map((line, i) => (
        <span class="line">
          {line.style === 'highlight' ? (
            <span class="hl">
              <span class="hl__stroke" aria-hidden="true"></span>
              <span class="wipe hl__text" style={`animation-delay:${delayFor(i)}`}>{line.text}</span>
            </span>
          ) : (
            <span
              class:list={['wipe', line.style === 'outline' && 'outline']}
              style={`animation-delay:${delayFor(i)}`}
            >
              {line.text}
            </span>
          )}
        </span>
      ))
    }
  </h1>

  <div class="lede">
    <p class="intro">{hero.intro}</p>
    <a class="cta" href="#karya">
      {hero.ctaLabel} <span aria-hidden="true">→</span>
      <span class="visually-hidden">({projectCount} proyek)</span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--cream);
    border: var(--line);
    border-radius: var(--r-lg);
    padding: 38px 36px 30px;
    box-shadow: 10px 10px 0 var(--ink);
  }

  .grid-lines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      repeating-linear-gradient(0deg,  color-mix(in oklab, var(--ink) 8%, transparent) 0 1px, transparent 1px 26px),
      repeating-linear-gradient(90deg, color-mix(in oklab, var(--ink) 8%, transparent) 0 1px, transparent 1px 26px);
  }

  .blob {
    position: absolute;
    right: -60px; top: -60px;
    width: 260px; height: 260px;
    border-radius: 50%;
    background: var(--accent3);
    mix-blend-mode: multiply;
    opacity: .55;
    animation: floaty 9s ease-in-out infinite;
  }

  .eyebrow {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--ink);
    opacity: .7;
  }
  .rule { flex: 1; height: 2px; background: var(--ink); opacity: .25; }

  .headline {
    position: relative;
    margin: 14px 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    line-height: .88;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-size: clamp(40px, 6.4vw, 104px);
    text-transform: uppercase;
  }

  .line { display: block; overflow: hidden; }

  /* Sapuan kuas: mask bergerak dari kanan ke kiri saat masuk. */
  .wipe {
    display: inline-block;
    -webkit-mask-image: linear-gradient(97deg, #000 0 60%, rgba(0,0,0,.55) 68%, rgba(0,0,0,0) 76%);
    mask-image: linear-gradient(97deg, #000 0 60%, rgba(0,0,0,.55) 68%, rgba(0,0,0,0) 76%);
    -webkit-mask-size: 230% 100%;
    mask-size: 230% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    animation: brushWipe 1.1s cubic-bezier(.2,.8,.2,1) both;
  }

  .outline {
    color: transparent;
    -webkit-text-stroke: 2px var(--ink);
  }

  .hl { position: relative; display: inline-block; }
  .hl__text { position: relative; }
  .hl__stroke {
    position: absolute;
    left: -.06em; right: -.06em; bottom: .02em;
    height: .24em;
    background: var(--accent);
    clip-path: polygon(0% 22%,4% 4%,18% 12%,33% 2%,52% 14%,71% 4%,88% 16%,99% 6%,100% 78%,90% 96%,74% 84%,55% 98%,36% 86%,19% 97%,6% 84%,0 96%);
    transform-origin: left center;
    animation: strokeGrow .8s cubic-bezier(.2,.9,.15,1) .75s both;
  }

  .lede {
    position: relative;
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    animation: riseIn .7s ease-out 1.1s both;
  }

  .intro {
    margin: 0;
    max-width: 38ch;
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink);
    opacity: .8;
    text-wrap: pretty;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--ink);
    color: var(--cream);
    border-radius: 999px;
    padding: 14px 22px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: .1em;
    text-transform: uppercase;
    box-shadow: 4px 4px 0 var(--accent2);
    transition: transform .2s cubic-bezier(.2,.8,.2,1), box-shadow .2s;
  }
  .cta:hover {
    color: var(--cream);
    transform: translate(-3px,-3px);
    box-shadow: 8px 8px 0 var(--accent2);
  }

  @media (max-width: 680px) {
    .hero { padding: 26px 20px 24px; box-shadow: 6px 6px 0 var(--ink); }

    /* Di layar sempit blob ini jatuh tepat di belakang headline dan
       menurunkan keterbacaannya, jadi dikecilkan ke sudut. */
    .blob { width: 150px; height: 150px; right: -45px; top: -45px; }

    .eyebrow { flex-wrap: wrap; gap: 6px 12px; font-size: 10px; letter-spacing: .12em; }
    .rule { display: none; }
    .intro { font-size: 15px; }
  }
</style>
