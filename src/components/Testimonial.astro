---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'testimonials'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<figure class="cell quote" style="--span:5;--span-md:3">
  <blockquote class="text">
    <Content />
  </blockquote>
  <figcaption class="who">
    <span class="avatar" aria-hidden="true"></span>
    <span class="ident">
      {entry.data.author}
      <span class="role">{entry.data.role}</span>
    </span>
  </figcaption>
</figure>

<style>
  .quote {
    margin: 0;
    background: var(--accent);
    border: var(--line);
    border-radius: var(--r-md);
    padding: 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    box-shadow: 8px 8px 0 var(--ink);
  }

  .text { margin: 0; }
  /* Isi markdown dirender jadi <p>, jadi gayanya diturunkan ke anak. */
  .text :global(p) {
    margin: 0;
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 1.12;
    color: var(--ink);
    text-transform: uppercase;
    text-wrap: pretty;
  }
  .text :global(p)::before { content: '\201C'; }
  .text :global(p)::after  { content: '\201D'; }

  .who { display: flex; align-items: center; gap: 12px; }

  .avatar {
    width: 40px; height: 40px;
    flex: none;
    border-radius: 50%;
    border: var(--line);
    background: repeating-linear-gradient(135deg, color-mix(in oklab, var(--ink) 18%, transparent) 0 5px, transparent 5px 10px);
  }

  .ident {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .role { display: block; opacity: .6; }
</style>
