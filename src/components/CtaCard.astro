---
import { site } from '../lib/site';
const { cta, email } = site;
---

<section id="kontak" class="cell cta" style="--span:8;--span-md:6">
  <div class="top">
    <h2 class="heading">{cta.heading}</h2>
    <a class="mail" href={`mailto:${email}`}>{email}</a>
  </div>

  <div class="notes marquee">
    <div class="marquee__track">
      {
        [0, 1].map((copy) => (
          <div class="run" aria-hidden={copy === 1 ? 'true' : undefined}>
            {cta.notes.map((note) => (
              <>
                <span>{note}</span>
                <span aria-hidden="true">◆</span>
              </>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    background: var(--cream);
    border: var(--line);
    border-radius: var(--r-lg);
    padding: 26px 0 0;
    box-shadow: 10px 10px 0 var(--accent2);
    display: flex;
    flex-direction: column;
  }

  .top {
    padding: 0 26px;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
  }

  .heading {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(28px, 3.6vw, 54px);
    line-height: .92;
    text-transform: uppercase;
    color: var(--ink);
    /* heading di site.json boleh memakai baris baru sungguhan. */
    white-space: pre-line;
  }

  .mail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--ink);
    color: var(--cream);
    border-radius: 999px;
    padding: 15px 24px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: .1em;
    text-transform: uppercase;
    box-shadow: 4px 4px 0 var(--accent);
    transition: transform .2s cubic-bezier(.2,.8,.2,1), box-shadow .2s;
    word-break: break-all;
  }
  .mail:hover {
    color: var(--cream);
    transform: translate(-3px,-3px);
    box-shadow: 9px 9px 0 var(--accent);
  }

  .notes {
    margin-top: auto;
    border-top: var(--line);
    padding: 10px 0;
    background: var(--accent3);
  }
  .marquee__track { animation: marqueeRev calc(var(--ticker) * 0.8) linear infinite; }

  .run {
    display: flex;
    gap: 22px;
    padding-right: 22px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
  }

  @media (max-width: 680px) {
    .top { padding: 0 18px; }
    .cta { box-shadow: 6px 6px 0 var(--accent2); }
  }
</style>
