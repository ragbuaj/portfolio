---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';

import TopBar from '../components/TopBar.astro';
import Hero from '../components/Hero.astro';
import Portrait from '../components/Portrait.astro';
import Ticker from '../components/Ticker.astro';
import StatCard from '../components/StatCard.astro';
import ProjectCarousel from '../components/ProjectCarousel.astro';
import ToolsColumn from '../components/ToolsColumn.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import CtaCard from '../components/CtaCard.astro';
import SocialGrid from '../components/SocialGrid.astro';
import SiteFooter from '../components/SiteFooter.astro';

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;

/**
 * Proyek terbaru tampil lebih dulu. Diurutkan dari `year`, bukan dari `order`,
 * supaya proyek yang ditambahkan nanti langsung mendarat di tempat yang benar
 * tanpa perlu menomori ulang yang lain. `order` tetap dipakai untuk menentukan
 * urutan antar-proyek pada tahun yang sama.
 */
const byNewest = (
  a: { data: { year: number; order: number } },
  b: { data: { year: number; order: number } },
) => b.data.year - a.data.year || a.data.order - b.data.order;

const allProjects = (await getCollection('projects', ({ data }) => !data.draft)).sort(byNewest);
const featured = allProjects.filter((p) => p.data.featured);

const experience = (await getCollection('experience', ({ data }) => !data.draft)).sort(byOrder);
---

<BaseLayout>
  <div class="page">
    <TopBar />

    <div class="bento">
      <Hero projectCount={allProjects.length} />
      <Portrait />
      <Ticker items={site.ticker} />

      <StatCard />
      <ProjectCarousel projects={featured} />

      <ToolsColumn title="Perkakas" items={site.tools} />
      <ExperienceCard entries={experience} />

      <CtaCard />
      <SocialGrid />
      <SiteFooter />
    </div>
  </div>
</BaseLayout>

<script>
  // Sel bento muncul sambil naik begitu masuk layar.
  //
  // Kelas .reveal dipasang dari sini, bukan dari markup: kalau skrip ini
  // gagal dimuat, halaman tetap tampil utuh alih-alih kosong. Sel yang sudah
  // terlihat saat halaman dibuka sengaja dilewati supaya tidak berkedip.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (!reduced.matches) {
    const cells = Array.from(
      document.querySelectorAll<HTMLElement>('.bento > .cell'),
    ).filter((cell) => cell.getBoundingClientRect().top > window.innerHeight);

    if (cells.length > 0 && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          let staggered = 0;
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const cell = entry.target as HTMLElement;
            // Sel yang masuk layar berbarengan dimunculkan berurutan,
            // bukan serentak.
            cell.style.transitionDelay = `${staggered++ * 70}ms`;
            cell.classList.add('is-visible');
            observer.unobserve(cell);
          }
        },
        { rootMargin: '0px 0px -12% 0px' },
      );

      for (const cell of cells) {
        cell.classList.add('reveal');
        observer.observe(cell);
      }
    }
  }
</script>

<style>
  .page {
    min-height: 100vh;
    padding: 18px;
    background:
      radial-gradient(1200px 600px at 12% -10%, color-mix(in oklab, var(--accent3) 22%, transparent), transparent 70%),
      radial-gradient(900px 500px at 95% 8%, color-mix(in oklab, var(--accent2) 18%, transparent), transparent 70%),
      var(--ink);
  }

  @media (max-width: 680px) {
    .page { padding: 10px; }
  }
</style>
